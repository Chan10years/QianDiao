# Local-only runtime configuration. Copy to .env.local and replace placeholders.
APP_BASE_URL=http://127.0.0.1:3000
# 手机真机联调：允许的开发来源主机（逗号分隔，不含协议）。换 Wi-Fi 后只改这里。
MOBILE_DEV_ORIGINS=
HOSTNAME=0.0.0.0
PORT=3000
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=40000000
IMAGE_LONG_EDGE=2048
AI_MODE=fallback
# Required only when AI_MODE=qwen; never commit a real key.
DASHSCOPE_API_KEY=replace-with-local-secret
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_RECIPE_MODEL=qwen3.7-plus
QWEN_VISION_MODEL=replace-with-confirmed-model-id
ENABLE_WEB_SEARCH=false
SEARCH_TIMEOUT_MS=2500
LOG_LEVEL=info
DATA_RETENTION_DAYS=7
